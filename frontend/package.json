{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dev.json",
    "build:dev": "npm run typecheck && vite build --minify false --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
