# Wails / build
.task
bin/
build/bin/
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# Frontend（dist 內容由建置產生；.gitkeep 讓乾淨 clone 的 go:embed 可編譯）
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep

# 隱私：不得 commit 任何範圍檔、手牌或其輸出
*.txt
!testdata/parity/**/*.txt
!internal/**/testdata/**/*.txt
/ranges/
/Ranges/
/hand_histories/
*.html
!internal/report/template.html
!frontend/index.html
!frontend/dev/testdata/*.html
*.json
!internal/i18n/locales/**/*.json
!testdata/parity/**/*.json
!internal/**/testdata/**/*.json
!frontend/dev/testdata/*.json
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!build/config.yml
!build/windows/info.json
!build/appicon.icon/icon.json

# 其他
*.db
.env
.env.*
*.syso
*.log
.vscode/
.idea/
.DS_Store
